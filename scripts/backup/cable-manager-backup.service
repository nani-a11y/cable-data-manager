[Unit]
Description=Cable Data Manager Automated PostgreSQL Backup
Documentation=https://github.com/local-cable/cable-manager
After=docker.service network-online.target
Wants=docker.service

[Service]
Type=oneshot
User=root
# Note: In production, configure WorkingDirectory, EnvironmentFile, and ExecStart to your production paths (e.g. /opt/cable-manager)
WorkingDirectory=/home/kowshik/Downloads/cable-manager-phase1
EnvironmentFile=-/home/kowshik/Downloads/cable-manager-phase1/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/bin/bash /home/kowshik/Downloads/cable-manager-phase1/scripts/backup/backup-postgres.sh

# Filesystem Sandboxing
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/cable-manager-backups /tmp /run/docker.sock /etc/cable-manager/gnupg /root/.gnupg
PrivateTmp=true
UMask=0077

# Process & Kernel Hardening Directives
NoNewPrivileges=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
ProtectClock=true
ProtectKernelLogs=true
ProtectHostname=true
RestrictRealtime=true
MemoryDenyWriteExecute=true

# Logging & Reliability Limits
StandardOutput=journal
StandardError=journal
TimeoutSec=900
