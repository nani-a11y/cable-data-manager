# ==============================================================================
# CABLE DATA MANAGER — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure values before starting.
# ==============================================================================

# Database Credentials
POSTGRES_DB=cable_manager
POSTGRES_USER=cable_admin
POSTGRES_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://cable_admin:CHANGE_THIS_DATABASE_PASSWORD@db:5432/cable_manager

# Application Environment: "development" or "production"
# When set to "production", strict validation rejects placeholder or weak secrets.
APP_ENV=development

# JWT Secret: In production, generate using: openssl rand -hex 32
# Must be at least 32 characters and cryptographically random.
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRE_MINUTES=1440

# Initial Administrator Credentials (seeded only if admin table is empty)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Trusted Proxies for Client IP Resolution (comma-separated IPs/CIDRs)
# In Docker production with static IPAM, only the frontend reverse proxy (172.28.0.10) and loopback are trusted:
TRUSTED_PROXIES=127.0.0.1,172.28.0.10

# Production Host Interface Binding & Port (docker-compose.prod.yml)
# Defaults safely to 127.0.0.1 (loopback).
# For WireGuard VPN or LAN access, bind to that specific interface IP:
# e.g. BIND_IP=10.8.0.1 or BIND_IP=192.168.1.100
BIND_IP=127.0.0.1
PROD_PORT=8080

# ==============================================================================
# Automated Backup & Recovery Configuration (Phase 4C)
# ==============================================================================
# Destination directory for encrypted backups (typically dedicated external SSD mount)
BACKUP_DIR=/mnt/cable-manager-backups

# In production with an external SSD, set to true so missing mount halts backup
REQUIRE_MOUNT=false
MIN_DISK_SPACE_MB=500

# GPG Public Key Recipient Email or Key ID (used to encrypt backups unattended)
BACKUP_GPG_RECIPIENT=backup@cable-manager.local

# Retention Policy (Daily days, Weekly weeks, Monthly months)
DAILY_RETENTION=14
WEEKLY_RETENTION=8
MONTHLY_RETENTION=12
